# CloudLab experiment nodes. Copy to hosts.env (gitignored) and fill in.
# Hostnames come from the CloudLab "List View" tab of the experiment, e.g.
# hp042.utah.cloudlab.us. node0 is the server, the rest are clients.

SSH_USER=ddz
SSH_KEY=~/.ssh/id_ed25519

NODE0=hpXXX.utah.cloudlab.us
NODE1=hpYYY.utah.cloudlab.us

# Experiment LAN addresses from the profile (192.168.1.0/24).
NODE0_IP=192.168.1.1
NODE1_IP=192.168.1.2

# Interface carrying the experiment LAN on each node. Leave blank to have
# `cl.sh iface NODE` discover it from the IP above.
EXP_IFACE=

# Where the repository lives on the nodes.
REMOTE_DIR=/users/$SSH_USER/caladan-ae
